# ============================================================
# .env.example — 이 파일을 복사해서 .env.local 을 만드세요.
# .env.local 은 .gitignore에 포함되어 Git에 올라가지 않습니다.
# ============================================================

# Firebase 클라이언트 설정 (Firebase Console > Project Settings > General)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# FCM VAPID 공개키 (Firebase Console > Project Settings > Cloud Messaging > Web Push certificates)
REACT_APP_FIREBASE_VAPID_KEY=

# 관리자 접속 코드 (강력한 무작위 문자열로 설정하세요. 예: openssl rand -base64 32)
REACT_APP_ADMIN_CODE=

# ------------------------------------------------------------
# ElevenLabs TTS 키는 클라이언트에 두지 않습니다.
# functions/tts.js가 서버에서만 사용하므로 아래 명령으로 설정하세요.
#   firebase functions:secrets:set ELEVEN_LABS_API_KEY
#   firebase functions:secrets:set ELEVEN_LABS_VOICE_ID
# (REACT_APP_ 접두사가 붙은 값은 빌드 결과물에 그대로 노출됩니다.)
# ------------------------------------------------------------
