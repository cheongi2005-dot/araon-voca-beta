rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 여부 확인 함수 (이메일 허용목록 방식 — 여러 관리자 계정을 지원)
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'lds051105@naver.com',
        'araon@gmail.com'
      ];
    }

    // 1. users (학생 정보) 컬렉션
    match /users/{userId} {
      // 🎯 학부모는 parentLogin Cloud Function이 발급하는 Custom Token(studentEmail 클레임 포함)으로 로그인하고,
      // 로그인 화면의 "이메일 찾기"는 findEmailByNameAndPhone Cloud Function으로 처리되므로
      // 더 이상 비로그인 상태의 직접 read가 필요 없습니다.
      // ⚠️ 과거 "allow read: if request.auth != null;"는 로그인만 하면(즉 어떤 학생 계정으로든)
      // 다른 모든 학생의 이름/전화번호/출석기록까지 통째로 읽을 수 있는 개인정보 유출 취약점이었습니다.
      // 본인 문서(학생), 관리자, 또는 본인 자녀 문서(학부모 커스텀 토큰)만 읽도록 제한합니다.
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email == userId)
        || (request.auth != null && request.auth.token.studentEmail == userId);

      // 가입 직후(createUserWithEmailAndPassword 다음) 본인 문서만 생성 가능 — 임의 문서 생성 차단
      allow create: if request.auth != null && request.auth.token.email == userId;

      // ✅ [수정된 부분] 본인 이메일과 문서 ID(userId)가 일치하거나, 관리자일 경우 수정(update) 허용!
      allow update: if isAdmin() || (request.auth != null && request.auth.token.email == userId);

      // 삭제는 여전히 관리자만 가능
      allow delete: if isAdmin();
    }

    // 2. inquiries (문의) 컬렉션
    match /inquiries/{inquiryId} {
      // ⚠️ 과거 "allow read: if request.auth != null;"는 로그인만 하면 다른 모든 학생/학부모의
      // 문의 내용과 전화번호까지 통째로 읽을 수 있는 개인정보 유출 취약점이었습니다.
      // studentAuthEmail(작성자의 users 문서 ID)을 본인 인증 정보와 대조해 본인 것만 읽도록 제한합니다.
      // (studentAuthEmail이 없는 과거 문서는 backfillInquiryOwners Cloud Function으로 채운 뒤에만 읽힙니다)
      allow read: if isAdmin()
        || (request.auth != null && request.auth.token.email == resource.data.studentAuthEmail)
        || (request.auth != null && request.auth.token.studentEmail == resource.data.studentAuthEmail);

      // 생성 시에도 studentAuthEmail이 본인(또는 본인 자녀)의 것인지 검증해 도용을 막습니다.
      allow create: if request.auth != null
        && (request.resource.data.studentAuthEmail == request.auth.token.email
            || request.resource.data.studentAuthEmail == request.auth.token.studentEmail);

      allow update, delete: if isAdmin();
    }

    // 3. leaderboard (랭킹 집계) 컬렉션 — Cloud Functions(Admin SDK)만 기록하고,
    // 로그인한 클라이언트는 읽기만 가능합니다.
    match /leaderboard/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
